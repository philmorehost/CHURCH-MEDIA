# OS / editor
.DS_Store
Thumbs.db
.claude/

# Runtime artifacts — regenerated by the installer
storage/installed.lock
storage/migrations.json
storage/logs/*
storage/cache/*
!storage/logs/.keep
!storage/cache/.keep

# User-uploaded media (keep the directory placeholder files)
public/uploads/originals/*
public/uploads/reels/*
public/uploads/thumbs/*
public/uploads/webp/*
public/uploads/form-files/*
public/uploads/cms/*
!public/uploads/**/.keep

# Static ffmpeg binaries
ffmpeg-9.0/
bin/ffmpeg/

# Editor / IDE
.vscode/

# Build & download artifacts
*.aab
*.apk
*.zip
*.crdownload

# Firebase secrets & config — keep the service-account key OUT of the repo.
# (mobile/android/app/google-services.json is committed on purpose for the CI build)
/google-services.json
/*firebase-adminsdk*.json
*.service-account.json

